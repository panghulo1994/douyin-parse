# 复制为 .env 后填写；不填也能跑（用 --ai none 全本地模式）

# ---- AI（可选，用于标点恢复 + 可靠性分析）----
# 支持任意 OpenAI 兼容接口
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat
# 供应商快捷选择：deepseek / mimo
DOUYIN_AI_PROVIDER=

# ---- 运行参数 ----
# small / medium / large-v3，默认 small（large-v3 在 CPU 上约 1.7 倍音频时长）
DOUYIN_WHISPER_MODEL=small
# 输出根目录，默认 ./output
DOUYIN_OUTPUT_BASE=
# 设为 1 跳过画面文字提取
DISABLE_VIDEO_OCR=
